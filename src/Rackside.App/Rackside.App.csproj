<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Lets the project build on Linux/macOS (CI, cloud sessions); it only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>Rackside.App</RootNamespace>
    <AssemblyName>Rackside</AssemblyName>
    <ApplicationIcon>..\..\assets\Rackside.ico</ApplicationIcon>
    <!-- Self-contained publish (decided): dotnet publish -c Release -r win-x64 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Description>Maintenance of Catalyst switches over the console and SSH</Description>
    <Company>Jose Martorell</Company>
  </PropertyGroup>

  <!-- One Rackside.exe (~55 MB, compressed) that runs without installing .NET:
       dotnet publish src/Rackside.App -c Release -o publish -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\logo.png" LogicalName="Rackside.App.logo.png" />
    <!-- English -> Spanish for the texts of this window (the operation texts come from the Core table). -->
    <!-- WithCulture="false": without it MSBuild reads ".es." as the Spanish culture and moves the file to a
         satellite assembly (es\Rackside.resources.dll) instead of embedding it in Rackside.exe. -->
    <EmbeddedResource Include="Resources\ui.es.tsv" LogicalName="Rackside.App.ui.es.tsv" WithCulture="false" />
    <InternalsVisibleTo Include="Rackside.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rackside.Core\Rackside.Core.csproj" />
    <ProjectReference Include="..\Rackside.Transport\Rackside.Transport.csproj" />
    <ProjectReference Include="..\Rackside.Records\Rackside.Records.csproj" />
    <ProjectReference Include="..\Rackside.Operations\Rackside.Operations.csproj" />
  </ItemGroup>

</Project>
