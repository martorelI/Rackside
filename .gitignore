*.log
console_session*.txt
ssh_session*.txt
running_before*.txt
Report_*.html
push_report*.html
DRP_*/
RESET_*/
UPDATE_*/
PUSH_*/
# IOS images (large and licensed by Cisco)
*.bin
*.tar
*.SPA.*

